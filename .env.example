# ULTRON cloud — copie para .env somente no ambiente local.
# Nunca publique valores reais.
ULTRON_MODE=local
ULTRON_PUBLIC_URL=http://localhost:3000
ULTRON_API_URL=http://localhost:8000

# Supabase (publishable key pode ir ao frontend; secret/service_role nunca)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub App — acesso opcional e granular a repositórios
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# MCP remoto
ULTRON_MCP_RESOURCE_URL=
ULTRON_OAUTH_ISSUER=
ULTRON_OAUTH_AUDIENCE=
